# -----------------------------------------------------------------------------
# 1.  FIREBASE EMULATORS (leave as-is for local dev)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyD-CHANGE-ME-1234567890
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-next-todo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-next-todo.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123
NEXT_PUBLIC_FIREBASE_APP_ID=123
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-123
NEXT_PUBLIC_USE_EMULATORS=true


# -----------------------------------------------------------------------------
# 2.  FIREBASE ADMIN (local emulators ignore this, but schema required)
# -----------------------------------------------------------------------------
# Leave empty for emulators.  For production:
# 1. Go Firebase Console → Project Settings → Service Accounts
# 2. Click “Generate new private key” → download JSON
# 3. Base64 encode:  cat service-account.json | base64
# 4. Paste below:
FIREBASE_SERVICE_ACCOUNT_BASE64=

# -----------------------------------------------------------------------------
# 3.  GOOGLE MAPS API KEY and GEMINI API KEY
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API=your-google-maps-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here